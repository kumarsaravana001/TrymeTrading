# Copy to .env (git-ignored). Never commit real values. Never paste keys into chat.
TRYME_MODE=paper                 # paper | testnet | live
TRYME_REFLEX=rule                # rule | haiku

# REFLEX on Claude Haiku 5.5 (only when TRYME_REFLEX=haiku)
ANTHROPIC_API_KEY=

# Alerts (optional). Create a bot with @BotFather, then set both.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Binance futures TESTNET keys (only for TRYME_MODE=testnet)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# LIVE keys: trading permission only, withdrawals OFF, IP-whitelisted to this host.
# Leave empty until docs/APPROVAL_GATE.md is fully signed off.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
TRYME_LIVE_APPROVED=
